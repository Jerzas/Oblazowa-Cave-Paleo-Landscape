    <Style id="present-day-normal">
      <IconStyle>
        <color>bf2ca02c</color>
        <scale>0.45</scale>
        <Icon><href>https://jerzas.github.io/Oblazowa-Cave-Paleo-Landscape/img/link.png</href></Icon>
      <hotSpot x="0.5" y="0.5" xunits="fraction" yunits="fraction"/></IconStyle>
      <LineStyle><color>bf2ca02c</color><width>2</width></LineStyle>
      <LabelStyle><scale>0</scale></LabelStyle>
    </Style>
    <Style id="present-day-highlight">
