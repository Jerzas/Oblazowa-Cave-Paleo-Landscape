      <LineStyle><color>bf2ca02c</color><width>2</width></LineStyle>
      <LabelStyle><scale>1</scale></LabelStyle>
    </Style>
    <StyleMap id="present-day">
      <Pair><key>normal</key><styleUrl>#present-day-normal</styleUrl></Pair>
      <Pair><key>highlight</key><styleUrl>#present-day-highlight</styleUrl></Pair>
